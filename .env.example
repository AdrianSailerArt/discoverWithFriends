# Supabase (Project Settings -> API)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# MapTiler (cloud.maptiler.com -> API keys) – optional, sonst OSM-Fallback
NUXT_PUBLIC_MAPTILER_KEY=

# OpenRouteService – kommt mit dem Tour-Generator (v2), nur serverseitig
NUXT_ORS_API_KEY=

# Social logins on /login (comma-separated: google,github) – must be enabled in Supabase
NUXT_PUBLIC_AUTH_PROVIDERS=google
